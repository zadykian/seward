#!/bin/sh
# Refuses a commit whose staged changes hold a word of the local list or, where gitleaks is
# installed, a secret. The list has a word or phrase a line, matched case-insensitively where no
# letter or digit touches it, and _ separates words as - does. Blank lines and # lines are skipped.
# The hook names an added line by its file and number, never its text. It prints a file name whole.

set -eu

list=$HOME/.config/ws/forbidden-words
status=0

# match WORDS FILE OUT writes to OUT the lines of FILE that hold a word, each with its number, and
# fails where none does. grep -w counts _ as a letter, so grep reads a copy with each _ a space.
# The C locale keeps tr on bytes. An error of tr or grep ends the hook, and the commit with it.
match() {
    LC_ALL=C tr _ ' ' <"$2" >"$tmp/text" || exit
    rc=0
    grep -aniwF -f "$1" "$tmp/text" >"$3" || rc=$?
    [ "$rc" -le 1 ] || exit "$rc"
    return "$rc"
}

# show HITS FILE prints, indented, the lines of FILE whose numbers lead the lines of HITS, as git
# gives them, never with the spaces that match put for _.
show() {
    cut -d: -f1 "$1" |
        awk 'NR == FNR { hit[$1] = 1; next } FNR in hit { print "    " $0 }' - "$2" >&2
}

if [ -f "$list" ]; then
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    trap 'exit 1' INT TERM
    # The _ goes before the trim, so that an entry of _ alone goes, not a pattern of spaces.
    sed -e 'y/_/ /' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e '/^$/d' -e '/^#/d' \
        "$list" >"$tmp/words"

    # Each added line goes to added, its file and number to the same line of where. The options
    # keep the user's config out: the staged bytes as text, binary files too, and no textconv.
    git -c core.quotePath=false diff --cached --text --no-textconv --no-color --no-ext-diff \
        --no-prefix -U0 --inter-hunk-context=0 --diff-filter=d >"$tmp/diff"
    awk -v where="$tmp/where" '
        /^diff --git / { header = 1; next }
        header && /^\+\+\+ / { file = substr($0, 5); sub(/\t$/, "", file); next }
        /^@@ / {
            header = 0
            n = $3
            sub(/^\+/, "", n)
            sub(/,.*/, "", n)
            n += 0
            next
        }
        header { next }
        /^\+/ { print file ":" n >where; print substr($0, 2); n++; next }
        /^ / { n++ }
    ' "$tmp/diff" >"$tmp/added"
    if match "$tmp/words" "$tmp/added" "$tmp/hits"; then
        echo 'pre-commit: a word of the local list is in these added lines:' >&2
        show "$tmp/hits" "$tmp/where"
        status=1
    fi

    # -z, as git quotes a name with a tab, a newline, a quote or a backslash, and that would hide
    # a word from the match.
    git diff --cached --name-only --diff-filter=d -z >"$tmp/names0"
    tr '\0' '\n' <"$tmp/names0" >"$tmp/names"
    if match "$tmp/words" "$tmp/names" "$tmp/hits"; then
        echo 'pre-commit: a word of the local list is in these file names:' >&2
        show "$tmp/hits" "$tmp/names"
        status=1
    fi
fi

# gitleaks 8.19 replaced protect --staged with git --staged. Its status 3 is a finding, any other
# failure an error, and both refuse the commit.
if command -v gitleaks >/dev/null 2>&1; then
    if gitleaks git --help >/dev/null 2>&1; then
        set -- git --staged
    else
        set -- protect --staged
    fi
    rc=0
    gitleaks "$@" --no-banner --redact --verbose --log-level warn --exit-code 3 . || rc=$?
    if [ "$rc" = 3 ]; then
        echo 'pre-commit: gitleaks found a secret in the staged changes.' >&2
        status=1
    elif [ "$rc" != 0 ]; then
        echo "pre-commit: gitleaks failed with status $rc; the staged changes are unchecked." >&2
        status=1
    fi
fi

exit "$status"
