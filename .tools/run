#!/bin/sh
# Runs one of the lint tools `make lint` uses, at the version pinned here:
#
#   .tools/run NAME [ARG...]   runs the tool with the ARGs
#   .tools/run -path NAME      prints the path of the tool's executable
#
# Each tool comes from its GitHub release, for a Mac on arm64 alone, as seward does. The first run
# downloads it into .cache/tools and checks its SHA-256. A bump changes a tool's version and its
# sum, which the release's checksums file or GitHub's asset digest gives. It needs curl, tar, unzip
# and shasum. SwiftLint loads sourcekitd from the Xcode that DEVELOPER_DIR or xcode-select names.

set -eu

# say prints a message of the script's.
say() {
    printf '.tools/run: %s\n' "$*" >&2
}

# die prints a message of the script's and exits with status 1.
die() {
    say "$*"
    exit 1
}

# pin sets version, url, sum and member for the tool $1. member is the executable's path in the
# archive, or empty where the download is the executable itself.
pin() {
    gh=https://github.com
    case $1 in
    actionlint)
        version=1.7.12
        url=$gh/rhysd/actionlint/releases/download/v$version/actionlint_${version}_darwin_arm64.tar.gz
        member=actionlint
        sum=aba9ced2dee8d27fecca3dc7feb1a7f9a52caefa1eb46f3271ea66b6e0e6953f
        ;;
    gitleaks)
        version=8.30.1
        url=$gh/gitleaks/gitleaks/releases/download/v$version/gitleaks_${version}_darwin_arm64.tar.gz
        member=gitleaks
        sum=b40ab0ae55c505963e365f271a8d3846efbc170aa17f2607f13df610a9aeb6a5
        ;;
    rumdl)
        version=0.2.78
        url=$gh/rvben/rumdl/releases/download/v$version/rumdl-v$version-aarch64-apple-darwin.tar.gz
        member=rumdl
        sum=450f00cdbf1da3bc3fbdf56c52dc9e6b2ab08bfd1ee6a26b44848e52a180dba5
        ;;
    shellcheck)
        version=0.11.0
        url=$gh/koalaman/shellcheck/releases/download/v$version/shellcheck-v$version.darwin.aarch64.tar.gz
        member=shellcheck-v$version/shellcheck
        sum=339b930feb1ea764467013cc1f72d09cd6b869ebf1013296ba9055ab2ffbd26f
        ;;
    shfmt)
        version=3.14.1
        url=$gh/mvdan/sh/releases/download/v$version/shfmt_v${version}_darwin_arm64
        member=
        sum=b7c872db63553ccffc7253aba3ed7d4885a27d83f1ba567b1138c6315a5847e5
        ;;
    swiftlint)
        # The portable build, whose zip holds the executable and its license.
        version=0.65.1
        url=$gh/realm/SwiftLint/releases/download/$version/portable_swiftlint.zip
        member=swiftlint
        sum=c1e429b0599cf1b516f369a2d9ec04eaf0e436f3c12b637df8851fa52ff694d0
        ;;
    vale)
        version=3.23.0
        url=$gh/errata-ai/vale/releases/download/v$version/vale_${version}_macOS_arm64.tar.gz
        member=vale
        sum=b913574b2c83b541d8bc2d8938e53a58a2fb06bab15135efcc755afb074f4430
        ;;
    zizmor)
        version=1.30.1
        url=$gh/zizmorcore/zizmor/releases/download/v$version/zizmor-aarch64-apple-darwin.tar.gz
        member=zizmor
        sum=e28d22b087f9ebb8d99da6e740d348c930f559961c7c3f12badda54f882195a2
        ;;
    *)
        die "no tool $1: actionlint, gitleaks, rumdl, shellcheck, shfmt, swiftlint, vale or zizmor"
        ;;
    esac
}

# sha256 prints the SHA-256 checksum of the file $1.
sha256() {
    shasum -a 256 <"$1" | awk '{ print $1 }'
}

# fetch downloads the tool $1 to $bin, checked against its sum. The executable moves into place
# last, so that a download cut short or a second run at once leaves no partial file there.
fetch() {
    mkdir -p "$cache"
    tmp=$(mktemp -d "$cache/.fetch.XXXXXX")
    trap 'rm -rf "$tmp"' EXIT
    trap 'exit 1' HUP INT TERM
    say "downloading $1 $version"
    curl -fsSL --retry 3 --proto-redir =https -o "$tmp/download" "$url" ||
        die "cannot download $url"
    [ "$(sha256 "$tmp/download")" = "$sum" ] ||
        die "$url does not match the SHA-256 pinned in .tools/run"
    if [ -n "$member" ]; then
        case $url in
        *.zip) unzip -q "$tmp/download" "$member" -d "$tmp" ;;
        *) tar -xzf "$tmp/download" -C "$tmp" "$member" ;;
        esac || die "$url has no $member"
        mv "$tmp/$member" "$tmp/download"
    fi
    chmod 755 "$tmp/download"
    mkdir -p "${bin%/*}"
    mv -f "$tmp/download" "$bin"
    rm -rf "$tmp"
    trap - EXIT HUP INT TERM
}

main() {
    path=false
    if [ "${1-}" = -path ]; then
        path=true
        shift
    fi
    [ $# -ge 1 ] || die "usage: .tools/run NAME [ARG...] or .tools/run -path NAME"
    name=$1
    shift
    [ "$(uname -s)-$(uname -m)" = Darwin-arm64 ] ||
        die "the tools are pinned for a Mac on arm64, not $(uname -s) on $(uname -m)"
    pin "$name"
    cache=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)/.cache/tools
    bin=$cache/$name-$version/$name
    [ -x "$bin" ] || fetch "$name"
    if $path; then
        printf '%s\n' "$bin"
    else
        exec "$bin" "$@"
    fi
}

main "$@"
